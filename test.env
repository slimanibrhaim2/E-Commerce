# k6 Load Testing Configuration
# Set these environment variables before running tests

# API Configuration
BASE_URL=http://localhost:44362

# Scaling factors (multiply all values)
SCALE_USERS=1        # Scale virtual users (0.5 = half users, 2 = double users)
SCALE_DURATION=1     # Scale test duration (0.5 = half time, 2 = double time)

# Smoke Test Configuration
SMOKE_VUS=1
SMOKE_DURATION=60
SMOKE_RESPONSE_TIME=1000
SMOKE_ERROR_RATE=0.01

# Load Test Virtual Users (Conservative based on test results)
LOAD_SMALL_VUS=50
LOAD_MEDIUM_VUS=150
LOAD_LARGE_VUS=300  # Reduced from 500 to avoid timeout issues

# Load Test Durations (seconds)
LOAD_RAMP_UP=120
LOAD_HOLD=300
LOAD_RAMP_DOWN=180

# Load Test Thresholds (Adjusted based on test results)
LOAD_RESPONSE_TIME=1000  # P95 < 1000ms (realistic based on 500 user results)
LOAD_ERROR_RATE=0.05     # Keep error rate strict for load testing

# STRESS TEST - Continue Until Failure
# Keep increasing users until 50% failure rate is reached
STRESS_VUS_STEP1=5
STRESS_VUS_STEP2=10
STRESS_VUS_STEP3=20
STRESS_VUS_STEP4=30
STRESS_VUS_STEP5=40
STRESS_VUS_STEP6=50
STRESS_VUS_STEP7=75
STRESS_VUS_STEP8=100
STRESS_VUS_STEP9=150
STRESS_VUS_STEP10=200
STRESS_VUS_STEP11=300
STRESS_VUS_STEP12=400
STRESS_VUS_STEP13=500
STRESS_VUS_STEP14=600
STRESS_VUS_STEP15=700
STRESS_VUS_STEP16=800
STRESS_VUS_STEP17=900
STRESS_VUS_STEP18=1000
STRESS_VUS_STEP19=1200
STRESS_VUS_STEP20=1400
STRESS_VUS_STEP21=1600
STRESS_VUS_STEP22=1800
STRESS_VUS_STEP23=2000
STRESS_VUS_STEP24=2500
STRESS_VUS_STEP25=3000
STRESS_VUS_STEP26=4000
STRESS_VUS_STEP27=5000
STRESS_VUS_STEP28=6000
STRESS_VUS_STEP29=7000
STRESS_VUS_STEP30=8000
STRESS_PEAK_VUS=10000  # Will auto-stop at 50% failure before reaching this

# Simple timing: 1 minute per step
STRESS_RAMP_TIME=30         # 30 seconds to reach each level
STRESS_HOLD_TIME=30         # 30 seconds hold at each level (total 1 min per step)
STRESS_RAMP_DOWN=60         # 1 minute ramp down

# Stress Test Thresholds (Realistic Benchmarks)
STRESS_RESPONSE_TIME=1000   # P95 < 1000ms (realistic target)
STRESS_AVG_RESPONSE_TIME=500 # Average < 500ms
STRESS_ERROR_RATE=0.15      # Allow up to 15% errors during stress testing