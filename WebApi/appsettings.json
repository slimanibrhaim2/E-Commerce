{
  "ConnectionStrings": {
    "DefaultConnection": "Server=DESKTOP-0JE77H7\\SQLEXPRESS;Database=E-Commerce;Integrated Security=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "E-Commerce-Super-Secret-Key-2024-With-At-Least-32-Chars",
    "Issuer": "E-Commerce-API",
    "Audience": "E-Commerce-Client",
    "ExpiryInMinutes": 10080
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/E-Commerce-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] [{RequestId}] [{UserId}] {Message:lj}{NewLine}{Exception}",
          "shared": true
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341/"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "E-Commerce-API",
      "Environment": "Production"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "BasePath": "wwwroot/uploads",
    "AllowedFileTypes": ["image/jpeg", "image/png", "image/gif"],
    "MaxFileSize": 5242880
  }
}
